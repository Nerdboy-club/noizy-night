/* =====================================================================
   Silent Night — game UI style sheet (UI Toolkit USS, Unity 6)
   Look: chunky Christmas toys. Thick dark-brown outlines, wooden/felt
   plaques with a heavier bottom border for "depth", gold/cream/red/green.
   Reference resolution 1920x1080 (runtime PanelSettings scale-with-screen).
   No variables / gradients / box-shadow (unsupported or unreliable at runtime).
   Palette:
     outline #2A140A  wood-dark #3B2314  wood #6B3E22  wood-light #8A5530
     cream #FFF3D6  paper #F7E6C4  gold #F2B630  gold-dark #B07A12
     red #C8282E  red-dark #7E1418  green #2E9A45  green-dark #18491F
     spooky #3A1E52 / #1E0F2E / #B07CFF
   ===================================================================== */

.sn-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(255, 243, 214);
    font-size: 24px;
}

Label {
    margin: 0;
    padding: 0px;
}

.sn-grow { flex-grow: 1; }

.sn-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
}

/* ----------------------------------------------------------------- key caps */
.sn-key {
    min-width: 40px;
    height: 40px;
    padding: 0px 10px 0px 10px;
    margin-right: 10px;
    background-color: rgb(255, 246, 224);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(255, 255, 255);
    border-bottom-width: 7px;
    border-bottom-color: rgb(170, 140, 105);
    border-radius: 10px;
    color: rgb(42, 20, 10);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.sn-key--big {
    min-width: 58px;
    height: 58px;
    font-size: 32px;
    border-radius: 14px;
}

/* ----------------------------------------------------------------- buttons */
.sn-btn {
    margin: 8px;
    padding: 12px 34px 14px 34px;
    min-height: 72px;
    background-color: rgb(107, 62, 34);
    border-width: 5px;
    border-bottom-width: 11px;
    border-color: rgb(42, 20, 10);
    border-radius: 22px;
    color: rgb(255, 243, 214);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 3px 0px rgba(42, 20, 10, 0.75);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale, translate, background-color;
    transition-duration: 0.08s, 0.08s, 0.12s;
}

.sn-btn:hover {
    scale: 1.06 1.06;
    background-color: rgb(138, 85, 48);
}

.sn-btn:active {
    scale: 0.97 0.97;
    translate: 0px 4px;
    border-bottom-width: 6px;
}

.sn-btn:disabled {
    background-color: rgb(90, 74, 64);
    color: rgb(170, 150, 130);
    scale: 1 1;
    translate: 0px 0px;
    opacity: 0.8;
}

.sn-btn--red { background-color: rgb(200, 40, 46); }
.sn-btn--red:hover { background-color: rgb(226, 62, 64); }
.sn-btn--green { background-color: rgb(46, 154, 69); }
.sn-btn--green:hover { background-color: rgb(64, 182, 88); }
.sn-btn--wood { background-color: rgb(107, 62, 34); }
.sn-btn--wood:hover { background-color: rgb(138, 85, 48); }
.sn-btn--gold {
    background-color: rgb(242, 182, 48);
    color: rgb(42, 20, 10);
    -unity-text-outline-width: 0px;
    text-shadow: 0px 2px 0px rgba(255, 243, 214, 0.6);
}
.sn-btn--gold:hover { background-color: rgb(255, 204, 84); }

.sn-btn--big {
    min-height: 88px;
    font-size: 38px;
    padding: 14px 52px 16px 52px;
}

.sn-btn--huge {
    min-height: 104px;
    min-width: 460px;
    font-size: 46px;
    border-radius: 28px;
    border-bottom-width: 14px;
}

.sn-btn--close {
    width: 72px;
    height: 72px;
    min-height: 72px;
    padding: 0px;
    margin: 0 0 0 16px;
    border-radius: 36px;
    background-color: rgb(200, 40, 46);
    border-bottom-width: 8px;
}
.sn-btn--close:hover { background-color: rgb(226, 62, 64); }

.sn-btn__icon { width: 36px; height: 36px; }
.sn-btn__coin { width: 34px; height: 34px; margin-right: 8px; }
.sn-btn__label {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(42, 20, 10);
}

/* scale-in when a dialog appears (class removed a moment later) */
.sn-dialog, .sn-panel, .sn-sign {
    transition-property: scale, opacity;
    transition-duration: 0.18s, 0.18s;
    transition-timing-function: ease-out-back, ease-out;
}
.sn-pop {
    scale: 0.92 0.92;
    opacity: 0.4;
}

.sn-bump {
    scale: 1.15 1.15;
}

/* ----------------------------------------------------------------- chips (wallet/counters) */
.sn-chip {
    flex-direction: row;
    align-items: center;
    padding: 6px 22px 8px 10px;
    margin-bottom: 12px;
    min-height: 64px;
    background-color: rgb(59, 35, 20);
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(110, 68, 42);
    border-bottom-width: 8px;
    border-bottom-color: rgb(26, 12, 6);
    border-radius: 32px;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}
.sn-chip--gold {
    background-color: rgb(112, 66, 36);
    border-top-color: rgb(165, 100, 56);
    border-bottom-color: rgb(35, 16, 8);
}
.sn-chip--done {
    background-color: rgb(46, 154, 69);
    border-top-color: rgb(110, 215, 130);
    border-bottom-color: rgb(22, 85, 36);
}
.sn-chip__icon { width: 46px; height: 46px; margin-right: 10px; }
.sn-chip__value {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 3px 0px rgba(42, 20, 10, 0.8);
}

/* ================================================================= HUD */
.sn-hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* objective — small, top-left */
.sn-objective {
    position: absolute;
    left: 36px;
    top: 32px;
    max-width: 620px;
    flex-direction: row;
    align-items: center;
    padding: 10px 20px 12px 14px;
    background-color: rgba(64, 38, 22, 0.92);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(125, 78, 48);
    border-bottom-width: 6px;
    border-bottom-color: rgb(26, 12, 6);
    border-radius: 16px;
    transition-property: scale;
    transition-duration: 0.15s;
}
.sn-objective__mark {
    width: 14px;
    height: 34px;
    margin-right: 14px;
    background-color: rgb(245, 192, 46);
    border-width: 2px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(255, 235, 130);
    border-bottom-color: rgb(160, 95, 20);
    border-radius: 6px;
    flex-shrink: 0;
}
.sn-objective__text {
    font-size: 22px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 2px 0px rgba(42, 20, 10, 0.8);
    flex-shrink: 1;
}
.sn-hud--spooky .sn-objective { background-color: rgba(58, 30, 82, 0.9); }
.sn-hud--spooky .sn-objective__mark { background-color: rgb(176, 124, 255); }

/* wallet + counter — top-right */
.sn-topright {
    position: absolute;
    right: 36px;
    top: 28px;
    align-items: flex-end;
}

/* eye + toasts — top-centre */
.sn-topcenter {
    position: absolute;
    left: 0;
    right: 0;
    top: 20px;
    align-items: center;
}
.sn-eye-wrap {
    align-items: center;
    transition-property: scale;
    transition-duration: 0.15s;
}
.sn-eye-wrap--pulse { scale: 1.12 1.12; }
.sn-eye {
    width: 128px;
    height: 128px;
}
.sn-eye--big {
    width: 190px;
    height: 190px;
    margin: 8px 0 8px 0;
}
.sn-eye__label {
    margin-top: -10px;
    padding: 4px 18px 6px 18px;
    background-color: rgb(59, 35, 20);
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: rgb(42, 20, 10);
    border-radius: 14px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
}
.sn-eye-wrap--danger .sn-eye__label {
    background-color: rgb(200, 40, 46);
    font-size: 26px;
}

.sn-toasts {
    margin-top: 16px;
    align-items: center;
}
.sn-toast {
    margin-bottom: 10px;
    padding: 10px 30px 12px 30px;
    background-color: rgb(255, 243, 214);
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: rgb(42, 20, 10);
    border-radius: 20px;
    color: rgb(42, 20, 10);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: scale, opacity;
    transition-duration: 0.15s;
}
.sn-toast--red {
    background-color: rgb(200, 40, 46);
    border-top-color: rgb(255, 120, 120);
    border-bottom-color: rgb(110, 16, 20);
    color: rgb(255, 243, 214);
}
.sn-toast--green {
    background-color: rgb(46, 154, 69);
    border-top-color: rgb(105, 210, 125);
    border-bottom-color: rgb(20, 85, 35);
    color: rgb(255, 243, 214);
}
.sn-toast--gold {
    background-color: rgb(242, 182, 48);
    border-top-color: rgb(255, 235, 130);
    border-bottom-color: rgb(160, 95, 20);
    color: rgb(42, 20, 10);
}

/* noise gauge + bars — bottom-left */
.sn-gauge-wrap {
    position: absolute;
    left: 36px;
    bottom: 32px;
    align-items: flex-start;
}
.sn-gauge-plate {
    width: 330px;
    height: 200px;
    padding: 14px 14px 10px 14px;
    background-color: rgba(59, 35, 20, 0.92);
    border-width: 5px;
    border-bottom-width: 10px;
    border-color: rgb(42, 20, 10);
    border-top-left-radius: 165px;
    border-top-right-radius: 165px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    align-items: center;
}
.sn-hud--spooky .sn-gauge-plate { background-color: rgba(30, 15, 46, 0.92); }
.sn-gauge {
    width: 290px;
    height: 145px;
    flex-shrink: 0;
}
.sn-gauge__word {
    margin-top: -2px;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(140, 210, 140);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
}
.sn-gauge__word--warn { color: rgb(242, 182, 48); }
.sn-gauge__word--loud { color: rgb(255, 96, 80); font-size: 28px; }

.sn-bars {
    margin-top: 12px;
    width: 330px;
}
.sn-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.sn-bar__label {
    width: 104px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 2px 0px rgba(42, 20, 10, 0.9);
}
.sn-bar__track {
    flex-grow: 1;
    height: 30px;
    background-color: rgb(59, 35, 20);
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    border-radius: 15px;
    overflow: hidden;
}
.sn-bar__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
    border-radius: 11px;
}
.sn-bar__fill--stamina {
    background-color: rgb(46, 154, 69);
    border-top-width: 2px;
    border-top-color: rgb(110, 215, 130);
    border-bottom-width: 3px;
    border-bottom-color: rgb(25, 95, 40);
    transition-property: background-color;
    transition-duration: 0.18s;
}
.sn-bar__fill--stamina-low {
    background-color: rgb(215, 52, 40);
    border-top-color: rgb(255, 130, 120);
    border-bottom-color: rgb(130, 20, 15);
}
.sn-bar__fill--fuel {
    background-color: rgb(240, 122, 26);
    border-top-width: 2px;
    border-top-color: rgb(255, 190, 80);
    border-bottom-width: 3px;
    border-bottom-color: rgb(150, 70, 10);
}
.sn-bar__shine {
    position: absolute;
    left: 8px; right: 8px; top: 3px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.28);
}

/* catnip counter + "in hands" status — above the noise gauge */
.sn-hands-col {
    align-items: flex-start;
    margin-bottom: 12px;
}
.sn-catnip {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 4px 16px 6px 6px;
    background-color: rgba(46, 154, 69, 0.94);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(110, 215, 130);
    border-bottom-width: 6px;
    border-bottom-color: rgb(22, 85, 36);
    border-radius: 22px;
    transition-property: scale;
    transition-duration: 0.15s;
}
.sn-catnip .sn-key {
    min-width: 32px;
    height: 32px;
    font-size: 18px;
    border-bottom-width: 5px;
    border-radius: 8px;
    padding: 0px 6px 0px 6px;
}
.sn-catnip__text {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 2px 0px rgba(42, 20, 10, 0.9);
}
.sn-hands {
    max-width: 520px;
    padding: 8px 18px 10px 16px;
    background-color: rgba(64, 38, 22, 0.92);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(125, 78, 48);
    border-bottom-width: 6px;
    border-bottom-color: rgb(26, 12, 6);
    border-left-color: rgb(242, 182, 48);
    border-left-width: 8px;
    border-radius: 14px;
    transition-property: scale;
    transition-duration: 0.15s;
}
.sn-hud--spooky .sn-hands { background-color: rgba(58, 30, 82, 0.9); border-left-color: rgb(176, 124, 255); }
.sn-hands__title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(242, 182, 48);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
}
.sn-hands__hint {
    margin-top: 2px;
    font-size: 18px;
    white-space: normal;
    color: rgb(255, 243, 214);
}
.sn-hands__hint--danger {
    color: rgb(255, 96, 80);
    -unity-font-style: bold;
}

/* sack — bottom-right */
.sn-sack {
    position: absolute;
    right: 36px;
    bottom: 32px;
    align-items: flex-end;
}
.sn-sack__slots {
    flex-direction: row;
    padding: 10px 12px 14px 12px;
    background-color: rgba(59, 35, 20, 0.92);
    border-width: 5px;
    border-bottom-width: 10px;
    border-color: rgb(42, 20, 10);
    border-radius: 54px;
}
.sn-slot {
    width: 84px;
    height: 84px;
    margin: 0 5px 0 5px;
    border-width: 5px;
    border-color: rgb(42, 20, 10);
    border-radius: 42px;
    background-color: rgb(74, 46, 30);
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}
.sn-slot__icon {
    width: 56px;
    height: 56px;
    display: none;
}
.sn-slot--full {
    background-color: rgb(255, 244, 218);
    border-color: rgb(242, 182, 48);
    border-top-color: rgb(255, 230, 120);
    border-bottom-color: rgb(160, 95, 20);
    border-bottom-width: 8px;
}
.sn-slot--full .sn-slot__icon { display: flex; }
.sn-sack__label {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}
.sn-sack__text {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 2px 0px rgba(42, 20, 10, 0.9);
}

/* interaction prompt — centre-bottom */
.sn-prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22%;
    align-items: center;
}
.sn-prompt__plaque {
    flex-direction: row;
    align-items: center;
    padding: 10px 30px 12px 14px;
    background-color: rgba(64, 38, 22, 0.94);
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(126, 78, 48);
    border-bottom-width: 9px;
    border-bottom-color: rgb(26, 12, 6);
    border-radius: 24px;
}
.sn-prompt__text {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 3px 0px rgba(42, 20, 10, 0.8);
}

/* hub hint — bottom-centre */
.sn-hint {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 6px 20px 8px 20px;
    background-color: rgba(42, 20, 10, 0.65);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(120, 75, 45, 0.45);
}
.sn-hint .sn-key {
    min-width: 34px;
    height: 34px;
    font-size: 18px;
    margin-right: 8px;
    border-bottom-width: 5px;
}
.sn-hint__text {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 2px 0px rgba(42, 20, 10, 0.9);
}

/* ================================================================= MAIN MENU */
.sn-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}
/* ================================================================= R.E.P.O. MAIN MENU */
.sn-screen--repo {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    padding: 50px 70px 50px 70px;
    background-color: rgb(22, 14, 18);
}

.sn-repo-col {
    width: 520px;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
}

.sn-repo-title {
    margin-bottom: 24px;
}

.sn-repo-title__kicker {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(245, 180, 40);
    text-shadow: 0px 3px 0px rgba(42, 20, 10, 0.9);
}

.sn-repo-title__big {
    font-size: 56px;
    -unity-font-style: bold;
    white-space: nowrap;
    letter-spacing: 3px;
    color: rgb(255, 245, 225);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 6px 0px rgb(42, 20, 10);
    margin-top: 4px;
    margin-bottom: 6px;
}

.sn-repo-title__tag {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(245, 180, 40);
    margin-top: 4px;
}

.sn-repo-nav {
    flex-direction: column;
    margin-top: 18px;
    margin-bottom: 20px;
}

.sn-repo-btn {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    padding: 10px 14px 10px 0px;
    margin-bottom: 12px;
    transition-property: translate;
    transition-duration: 0.12s;
}

.sn-repo-btn:hover {
    translate: 8px 0px;
}

.sn-repo-btn__arrow {
    font-size: 24px;
    color: rgb(245, 180, 40);
    opacity: 0;
    margin-right: 14px;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.sn-repo-btn:hover .sn-repo-btn__arrow {
    opacity: 1;
}

.sn-repo-btn__text {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(225, 215, 195);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 3px 0px rgba(20, 10, 5, 0.95);
    transition-property: color;
    transition-duration: 0.12s;
}

.sn-repo-btn:hover .sn-repo-btn__text {
    color: rgb(255, 245, 215);
}

.sn-repo-bottom__text {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(255, 240, 210, 0.55);
}

/* Right Staging & Showcase Area */
.sn-repo-right {
    flex-grow: 1;
    margin-left: 60px;
    align-items: center;
    justify-content: center;
}

.sn-repo-card {
    width: 860px;
    padding: 30px 40px 34px 40px;
    background-color: rgb(42, 26, 18);
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(130, 80, 50);
    border-bottom-width: 10px;
    border-bottom-color: rgb(20, 10, 6);
    border-radius: 28px;
}

.sn-repo-showcase-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.sn-repo-preview-frame {
    width: 250px;
    height: 250px;
    min-width: 250px;
    min-height: 250px;
    margin-right: 28px;
    background-color: rgb(16, 12, 18);
    border-width: 3px;
    border-color: rgb(75, 45, 25);
    border-top-color: rgb(150, 100, 50);
    border-radius: 20px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.sn-repo-preview-img {
    width: 244px;
    height: 244px;
    border-radius: 16px;
}

.sn-repo-details {
    flex-grow: 1;
    flex-direction: column;
}

.sn-repo-card__header {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(245, 185, 45);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 3px 0px rgba(42, 20, 10, 0.9);
    margin-bottom: 14px;
}

.sn-repo-card__info {
    margin-bottom: 12px;
}

.sn-repo-card__title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 245, 225);
    margin-bottom: 4px;
}

.sn-repo-card__role {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(245, 185, 45);
    margin-bottom: 10px;
}

.sn-repo-card__desc {
    font-size: 18px;
    color: rgb(215, 185, 155);
    white-space: normal;
    margin-bottom: 20px;
}

.sn-repo-card__nav {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 18px;
}

.sn-repo-card__arrow-btn {
    min-width: 200px;
}

.sn-repo-swatches {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.sn-repo-swatch {
    margin: 4px;
    padding: 8px 14px 8px 14px;
    background-color: rgb(30, 18, 12);
    border-width: 2px;
    border-color: rgb(55, 30, 18);
    border-radius: 12px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(200, 180, 160);
}

.sn-repo-swatch--active {
    background-color: rgb(46, 154, 69);
    border-color: rgb(110, 215, 130);
    color: rgb(255, 255, 255);
}

.sn-repo-card__status {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 240, 210);
    margin-bottom: 16px;
}

.sn-repo-card__ip-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.sn-repo-card__ip-val {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(120, 215, 140);
    margin-right: 14px;
}

.sn-repo-roster {
    margin-bottom: 20px;
}

.sn-repo-roster__slot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px 10px 18px;
    margin-bottom: 8px;
    background-color: rgb(30, 16, 10);
    border-width: 2px;
    border-color: rgb(42, 20, 10);
    border-radius: 14px;
}

.sn-repo-roster__slot--active {
    background-color: rgb(55, 30, 18);
    border-color: rgb(245, 185, 45);
    border-left-width: 6px;
}

.sn-repo-roster__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
}

.sn-repo-roster__state {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(245, 185, 45);
}

.sn-repo-form {
    margin-bottom: 20px;
}

.sn-repo-form__label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    margin-top: 10px;
    margin-bottom: 4px;
}

.sn-repo-form__field {
    min-height: 44px;
    font-size: 20px;
    margin-bottom: 10px;
}

.sn-repo-card__footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
}

.sn-repo-card__start {
    min-width: 300px;
}

.sn-screen--menu { background-color: rgba(16, 10, 24, 0.55); }

.sn-sign {
    align-items: center;
    padding: 34px 90px 40px 90px;
    margin-bottom: 40px;
    background-color: rgb(116, 68, 38);
    border-width: 8px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(165, 100, 58);
    border-bottom-width: 18px;
    border-bottom-color: rgb(34, 15, 8);
    border-radius: 40px;
    rotate: -1.5deg;
}
.sn-sign__rope {
    position: absolute;
    top: -90px;
    width: 12px;
    height: 90px;
    background-color: rgb(190, 134, 24);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
}
.sn-sign__rope--l { left: 120px; }
.sn-sign__rope--r { right: 120px; }
.sn-sign__stars {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 4px;
}
.sn-sign__star { width: 64px; height: 64px; margin: 0 8px 0 8px; }
.sn-sign__star--small { width: 42px; height: 42px; }
.sn-title-kicker {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    color: rgb(242, 182, 48);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 4px 0px rgb(42, 20, 10);
}
.sn-title-big {
    font-size: 124px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(126, 20, 24);
    text-shadow: 0px 9px 0px rgb(42, 20, 10);
}
.sn-title-sub {
    margin-top: 8px;
    padding: 6px 28px 8px 28px;
    background-color: rgb(200, 40, 46);
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(255, 125, 125);
    border-bottom-width: 8px;
    border-bottom-color: rgb(108, 16, 20);
    border-radius: 18px;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    rotate: 1.5deg;
}
.sn-menu-buttons {
    align-items: center;
}
.sn-keys {
    position: absolute;
    left: 0; right: 0; bottom: 40px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}
.sn-keys__item {
    flex-direction: row;
    align-items: center;
    margin: 6px 16px 6px 16px;
}
.sn-keys__text {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 2px 0px rgba(42, 20, 10, 0.9);
}

/* ================================================================= MODAL PANELS */
.sn-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 10, 6, 0.6);
}
.sn-backdrop--dark { background-color: rgba(10, 8, 20, 0.72); }
.sn-backdrop--red { background-color: rgba(60, 6, 8, 0.7); }

.sn-panel {
    padding: 20px 30px 20px 30px;
    max-height: 92%;
    max-width: 94%;
    background-color: rgb(107, 62, 34);
    border-width: 8px;
    border-bottom-width: 18px;
    border-color: rgb(42, 20, 10);
    border-radius: 36px;
}
.sn-board { width: 1460px; }
.sn-bench { width: 1140px; }

.sn-panel__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}
.sn-panel__header .sn-chip { margin-bottom: 0; }
.sn-panel__title {
    padding: 6px 28px 8px 28px;
    background-color: rgb(200, 40, 46);
    border-width: 5px;
    border-bottom-width: 10px;
    border-color: rgb(42, 20, 10);
    border-radius: 20px;
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 4px 0px rgb(42, 20, 10);
    rotate: -1deg;
}
.sn-panel__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    flex-shrink: 0;
}

/* ----------------------------------------------------------------- order cards */
.sn-cards {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    padding: 22px 10px 16px 10px;
    min-height: 430px;
    background-color: rgb(74, 46, 30);
    border-width: 5px;
    border-color: rgb(42, 20, 10);
    border-radius: 24px;
}
.sn-cards__empty {
    font-size: 30px;
    -unity-font-style: bold;
    margin-top: 140px;
}

.sn-card {
    width: 410px;
    min-height: 380px;
    margin: 0 16px 0 16px;
    padding: 28px 24px 18px 24px;
    background-color: rgb(247, 230, 196);
    border-width: 5px;
    border-bottom-width: 12px;
    border-color: rgb(42, 20, 10);
    border-radius: 20px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    color: rgb(42, 20, 10);
    transition-property: scale, rotate, border-color, translate;
    transition-duration: 0.12s, 0.12s, 0.12s, 0.12s;
}
.sn-card--tilt0 { rotate: -2deg; }
.sn-card--tilt1 { rotate: 1.5deg; margin-top: 14px; }
.sn-card--tilt2 { rotate: -1deg; }
.sn-card:hover { scale: 1.04 1.04; translate: 0px -6px; }
.sn-card--selected {
    border-color: rgb(242, 182, 48);
    border-top-color: rgb(255, 235, 140);
    border-bottom-color: rgb(180, 110, 20);
    border-width: 8px;
    border-bottom-width: 14px;
    scale: 1.06 1.06;
    rotate: 0deg;
}
.sn-card--selected:hover { scale: 1.08 1.08; }

.sn-card__pin {
    position: absolute;
    top: -16px;
    left: 50%;
    margin-left: -18px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgb(215, 42, 48);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(255, 145, 145);
    border-bottom-color: rgb(130, 20, 20);
    border-bottom-width: 5px;
}
.sn-card__mood {
    align-self: flex-start;
    padding: 4px 14px 5px 14px;
    margin-bottom: 14px;
    background-color: rgb(46, 154, 69);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-radius: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 243, 214);
}
.sn-card__address {
    font-size: 36px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(42, 20, 10);
    margin-bottom: 10px;
}
.sn-card__desc {
    font-size: 19px;
    white-space: normal;
    color: rgb(92, 60, 40);
    margin-bottom: 16px;
}
.sn-card__gifts {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 18px;
}
.sn-card__gift { width: 58px; height: 58px; margin-right: 8px; }
.sn-card__gift--huge { width: 76px; height: 76px; }
.sn-card__reward {
    flex-direction: row;
    align-items: center;
}
.sn-card__coin { width: 52px; height: 52px; margin-right: 10px; }
.sn-card__money {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(42, 20, 10);
}
.sn-card__mult {
    margin-left: 12px;
    padding: 2px 10px 4px 10px;
    background-color: rgb(242, 182, 48);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(42, 20, 10);
}
.sn-card__stamp {
    position: absolute;
    right: 18px;
    bottom: 22px;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 6px;
    border-color: rgb(176, 124, 255);
    background-color: rgb(106, 58, 154);
    font-size: 58px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(30, 15, 46);
    rotate: 14deg;
}
.sn-card__check {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    background-color: rgb(242, 182, 48);
    display: none;
}
.sn-card--selected .sn-card__check { display: flex; }

/* spooky variant */
.sn-card--spooky {
    background-color: rgb(58, 30, 82);
    border-color: rgb(30, 15, 46);
}
.sn-card--spooky.sn-card--selected { border-color: rgb(176, 124, 255); }
.sn-card--spooky .sn-card__mood { background-color: rgb(30, 15, 46); color: rgb(176, 124, 255); }
.sn-card--spooky .sn-card__address { color: rgb(255, 243, 214); }
.sn-card--spooky .sn-card__desc { color: rgb(200, 180, 230); }
.sn-card--spooky .sn-card__money { color: rgb(255, 243, 214); }
.sn-card--spooky .sn-card__pin { background-color: rgb(176, 124, 255); }

/* ----------------------------------------------------------------- workbench */
.sn-upgrades {
    padding: 12px;
    background-color: rgb(74, 46, 30);
    border-width: 5px;
    border-color: rgb(42, 20, 10);
    border-radius: 24px;
}
.sn-upg {
    flex-direction: row;
    align-items: center;
    margin: 5px 0 5px 0;
    padding: 8px 16px 10px 12px;
    background-color: rgb(247, 230, 196);
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: rgb(42, 20, 10);
    border-radius: 20px;
    transition-property: scale;
    transition-duration: 0.12s;
}
.sn-upg--maxed { background-color: rgb(255, 236, 170); }
.sn-upg__plate {
    width: 82px;
    height: 82px;
    margin-right: 16px;
    border-radius: 41px;
    border-width: 5px;
    border-color: rgb(42, 20, 10);
    background-color: rgb(107, 62, 34);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.sn-upg__icon { width: 56px; height: 56px; }
.sn-upg__info { flex-grow: 1; }
.sn-upg__name {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(42, 20, 10);
}
.sn-upg__desc {
    font-size: 18px;
    color: rgb(92, 60, 40);
    margin-bottom: 6px;
}
.sn-pips { flex-direction: row; align-items: center; }
.sn-pip {
    width: 38px;
    height: 20px;
    margin-right: 8px;
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(30, 14, 8);
    border-bottom-color: rgb(75, 45, 25);
    border-radius: 10px;
    background-color: rgb(70, 52, 42);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}
.sn-pip--on {
    background-color: rgb(245, 192, 46);
    border-color: rgb(150, 85, 20);
    border-top-color: rgb(255, 230, 130);
    border-bottom-color: rgb(105, 50, 10);
}
.sn-upg__buy {
    min-width: 200px;
    margin: 0 0 0 16px;
}
.sn-upg__buy--max { background-color: rgb(46, 154, 69); }
.sn-upg__buy--max .sn-btn__label { color: rgb(255, 243, 214); }
.sn-upg__buy:disabled .sn-btn__label { color: rgb(200, 180, 160); }

/* ================================================================= DIALOGS (results / game over / pause) */
.sn-dialog {
    width: 820px;
    align-items: center;
    padding: 70px 50px 34px 50px;
    background-color: rgb(107, 62, 34);
    border-width: 8px;
    border-bottom-width: 18px;
    border-color: rgb(42, 20, 10);
    border-radius: 40px;
}
.sn-dialog--gold {
    background-color: rgb(46, 110, 58);
    border-top-color: rgb(75, 165, 90);
    border-bottom-color: rgb(20, 55, 28);
}
.sn-dialog--red {
    background-color: rgb(110, 26, 30);
    border-top-color: rgb(170, 45, 50);
    border-bottom-color: rgb(55, 10, 14);
}

.sn-dialog__ribbon {
    position: absolute;
    top: -46px;
    padding: 12px 48px 14px 48px;
    background-color: rgb(242, 182, 48);
    border-width: 6px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(255, 235, 130);
    border-bottom-width: 12px;
    border-bottom-color: rgb(150, 95, 20);
    border-radius: 22px;
    font-size: 50px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(126, 20, 24);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    rotate: -1.5deg;
}
.sn-dialog__ribbon--red {
    background-color: rgb(200, 40, 46);
    border-top-color: rgb(255, 120, 120);
    border-bottom-color: rgb(110, 15, 20);
    color: rgb(255, 243, 214);
}
.sn-dialog__address {
    font-size: 34px;
    -unity-font-style: bold;
    margin: 8px 0 16px 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
}
.sn-dialog__text {
    font-size: 30px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 6px 0 22px 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
}
.sn-dialog__bonus {
    margin: 4px 0 14px 0;
    padding: 4px 18px 6px 18px;
    background-color: rgb(106, 58, 154);
    border-width: 3px;
    border-color: rgb(42, 20, 10);
    border-radius: 12px;
    font-size: 22px;
    -unity-font-style: bold;
}
.sn-dialog__buttons {
    align-items: stretch;
    width: 520px;
}
.sn-dialog__hint {
    margin-top: 10px;
    font-size: 20px;
    opacity: 0.75;
}

.sn-stars {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 4px;
}
.sn-star { width: 96px; height: 96px; margin: 0 6px 0 6px; }
.sn-star--mid { width: 130px; height: 130px; }

.sn-stats {
    width: 560px;
    padding: 12px 24px 14px 24px;
    margin-bottom: 18px;
    background-color: rgb(247, 230, 196);
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: rgb(42, 20, 10);
    border-radius: 22px;
}
.sn-stat {
    flex-direction: row;
    align-items: center;
    padding: 6px 0 6px 0;
}
.sn-stat__name {
    flex-grow: 1;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(92, 60, 40);
}
.sn-stat__coin { width: 46px; height: 46px; margin-right: 8px; }
.sn-stat__value {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(42, 20, 10);
}
.sn-stat__value--big { font-size: 52px; color: rgb(176, 122, 18); }

/* ---- Results: comedic run recap ---- */
.sn-recap {
    width: 560px;
    padding: 8px 20px 10px 20px;
    margin-bottom: 14px;
    background-color: rgb(255, 245, 222);
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: rgb(42, 20, 10);
    border-radius: 16px;
}
.sn-recap__rank-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}
.sn-recap__rank-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(92, 60, 40);
    margin-right: 8px;
}
.sn-recap__rank {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 248, 230);
    padding: 3px 14px 4px 14px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(42, 20, 10);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
    background-color: rgb(176, 122, 18);
}
.sn-recap__rank--mouse { background-color: rgb(120, 180, 220); }
.sn-recap__rank--ninja { background-color: rgb(110, 170, 90); }
.sn-recap__rank--elephant { background-color: rgb(220, 110, 80); }
.sn-recap__line {
    font-size: 20px;
    color: rgb(72, 44, 28);
    white-space: normal;
    padding: 1px 0 1px 0;
}

/* ----------------------------------------------------------------- reticle & team countdown */
.sn-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    translate: -4px -4px;
    background-color: rgba(255, 243, 214, 0.75);
    border-width: 2px;
    border-color: rgb(42, 20, 10);
    border-radius: 4px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.1s;
}
.sn-reticle--focus {
    scale: 2 2;
    background-color: rgb(242, 182, 48);
    border-color: rgb(42, 20, 10);
}

.sn-countdown-banner {
    position: absolute;
    top: 155px;
    left: 50%;
    translate: -50% 0;
    min-width: 360px;
    padding: 12px 32px 14px 32px;
    background-color: rgba(186, 32, 38, 0.95);
    border-width: 4px;
    border-color: rgb(42, 20, 10);
    border-top-color: rgb(255, 120, 120);
    border-bottom-width: 9px;
    border-bottom-color: rgb(105, 15, 20);
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.15s;
}
.sn-countdown-banner__title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(42, 20, 10);
    text-shadow: 0px 3px 0px rgba(42, 20, 10, 0.9);
}
.sn-countdown-banner__sub {
    margin-top: 2px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(242, 182, 48);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 20, 10);
}
